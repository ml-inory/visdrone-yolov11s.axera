{
  "model_type": "ONNX",
  "input": "export/model.onnx",
  "output_dir": "compile",
  "output_name": "model.axmodel",
  "target_hardware": "AX650",
  "npu_mode": "NPU3",

  "quant": {
    "input_configs": [
      {
        "tensor_name": "images",
        "calibration_dataset": "export/calib_data.tar",
        "calibration_format": "Image",
        "calibration_size": 10,
        "calibration_mean": [0, 0, 0],
        "calibration_std": [1, 1, 1]
      }
    ],
    "calibration_method": "MinMax",
    "precision_analysis": true,
    "precision_analysis_method": "PerLayer"
  }
}
